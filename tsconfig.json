{
  // the shared game engine, game player and guides (src/), and the puzzle tools (puzzles/);
  // the site (app/) has its own
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src", "puzzles"],
  "exclude": ["app", "archive", "scans", "references"]
}
