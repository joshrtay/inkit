---
// Small ink-drawn icons for the controls that sit on a puzzle's paper (see .tool in global.css).
interface Props { name: "undo" | "reset" | "check" | "hint" | "prev" | "next" | "print" }
const { name } = Astro.props;
const paths: Record<Props["name"], string[]> = {
  undo: ["M9 14 4 9l5-5", "M4 9h10.5a5.5 5.5 0 0 1 0 11H11"],
  reset: ["M3 12a9 9 0 1 0 2.6-6.4L3 8", "M3 3v5h5"],
  check: ["M20 6 9 17l-5-5"],
  prev: ["M15 18l-6-6 6-6"],
  next: ["M9 18l6-6-6-6"],
  print: ["M7 9V3h10v6", "M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2", "M7 14h10v7H7z"],
  hint: ["M9 18h6", "M10 21h4", "M12 3a6 6 0 0 0-3.6 10.8c.6.5.9 1.2.9 2V16h5.4v-.2c0-.8.3-1.5.9-2A6 6 0 0 0 12 3z"],
};
---
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {paths[name].map((d) => <path d={d} />)}
</svg>
