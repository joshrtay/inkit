---
import Base from "../layouts/Base.astro";
import { gameTypes, instancesOf } from "../games";
import { url } from "../lib/paths";

const listed = gameTypes.filter((t) => t.listed && instancesOf(t).length);
---
<Base title="Wyatt's Games" description="Printable and in-browser escape room puzzles.">
  <main class="wrap">

    <ul class="games">
      {listed.map((g) => (
        <li>
          <a class="game" href={url(`${g.path}/`)}
             data-progress-ids={JSON.stringify(instancesOf(g).map((i) => `${g.path}/${i.number}`))}>
            {g.cover
              ? <img src={url(g.cover)} alt={g.coverAlt ?? ""} width="1200" height="750" />
              : <div class="no-cover" aria-hidden="true">{g.name}</div>}
            <div class="text">
              <h2>{g.name}</h2>
              <span class="solved" hidden></span>
              <p>{g.blurb}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .wrap { gap: 36px; padding-block: 36px 64px; }

  .games { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .game {
    display: grid; grid-template-rows: auto 1fr; height: 100%;
    color: inherit; text-decoration: none; background: var(--panel);
    border-radius: 6px; overflow: hidden;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .game:hover { transform: translateY(-3px); box-shadow: 0 14px 28px -14px var(--shadow); }
  .game:focus-visible { outline-offset: 3px; }
  .game img, .no-cover { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; }
  .no-cover { display: grid; place-content: center; font-family: var(--display); font-size: 26px; background: var(--bg); color: var(--muted); }
  .text { padding: 16px 18px 18px; display: grid; gap: 6px; align-content: start; }
  .text p { margin: 0; color: var(--muted); font-size: 15px; }
  .text h2 { font-family: var(--display); font-weight: 400; font-size: 24px; line-height: 1.15; margin: 0; }
  .solved { justify-self: start; font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--good); }
  .solved::before { content: "\2713  "; }

  @media (prefers-reduced-motion: reduce) { .game { transition: none; } .game:hover { transform: none; } }
</style>

<script>
  import { countComplete } from "../lib/progress";

  document.querySelectorAll<HTMLElement>("[data-progress-ids]").forEach((card) => {
    const ids = JSON.parse(card.dataset.progressIds!) as string[];
    const n = countComplete(ids);
    const label = card.querySelector<HTMLElement>(".solved")!;
    if (n > 0) {
      label.textContent = `${n} of ${ids.length} solved`;
      label.hidden = false;
    }
  });
</script>
