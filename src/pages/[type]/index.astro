---
// One game type: its numbered instances.
import Base from "../../layouts/Base.astro";
import { gamePath, gameTypes, instancesOf } from "../../games";
import { url } from "../../lib/paths";

export function getStaticPaths() {
  return gameTypes.map((type) => ({ params: { type: type.path }, props: { type } }));
}

const { type } = Astro.props;
const list = instancesOf(type);
---
<Base title={type.name} description={type.blurb}>
  <main class="wrap">
    <header>
      <a class="back" href={url("/")}>&larr; All games</a>
      <h1>{type.name}</h1>
      <p>{type.blurb}</p>
    </header>

    <ol class="instances">
      {list.map((g) => (
        <li>
          <a href={url(gamePath(g))}>
            <span class="num">{g.number}</span>
            <span class="text">
              <strong>{g.name}</strong>
              {g.meta && <span class="meta">{g.meta}</span>}
            </span>
            <span class="go" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .wrap { max-width: 760px; }
  header { display: grid; gap: 8px; }
  h1 { font-family: var(--display); font-weight: 400; font-size: clamp(32px, 6vw, 48px); line-height: 1.05; margin: 0; }
  header p { margin: 0; color: var(--muted); }
  .instances { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .instances a {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px;
    padding: 14px 18px; color: inherit; text-decoration: none; background: var(--panel);
    border: 1px solid var(--line); border-radius: 4px; transition: border-color .15s, transform .15s;
  }
  .instances a:hover { border-color: var(--ink); transform: translateX(3px); }
  .num {
    font-family: var(--display); font-size: 26px; width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center; border: 2px solid var(--ink); font-variant-numeric: tabular-nums;
  }
  .text { display: grid; gap: 2px; min-width: 0; }
  .text strong { font-family: var(--display); font-weight: 400; font-size: 21px; }
  .meta { font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .go { font-family: var(--mono); font-size: 20px; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .instances a { transition: none; } .instances a:hover { transform: none; } }
</style>
