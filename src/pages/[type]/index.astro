---
// One game type: its numbered instances.
import Base from "../../layouts/Base.astro";
import { gamePath, gameTypes, instancesOf } from "../../games";
import { url } from "../../lib/paths";
import Check from "../../components/Check.astro";

export function getStaticPaths() {
  return gameTypes.map((type) => ({ params: { type: type.path }, props: { type } }));
}

const { type } = Astro.props;
const list = instancesOf(type).slice().reverse();   // newest (highest number) first
---
<Base title={type.name} description={type.blurb}>
  <main class="wrap">
    <header>
      <a class="back" href={url("/")}>&larr; All games</a>
      <h1>{type.name}</h1>
      <p>{type.blurb}</p>
    </header>

    <ol class="instances">
      {list.map((g) => (
        <li>
          <a href={url(gamePath(g))} data-progress-id={`${type.path}/${g.number}`}>
            <span class="num">{g.number}<Check size={22} /></span>
            <span class="text">
              <strong>{g.name}</strong>
              {g.meta && <span class="meta">{g.meta}</span>}
            </span>
            <span class="go" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .wrap { max-width: 760px; }
  header { display: grid; gap: 8px; }
  h1 { font-family: var(--display); font-weight: 800; font-size: clamp(28px, 5vw, 40px); line-height: 1.05; margin: 0; }
  header p { margin: 0; color: var(--muted); }
  .instances { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .instances a {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px;
    padding: 14px 18px; color: inherit; text-decoration: none; background: var(--panel);
    border: var(--card-border); border-radius: 6px; transition: border-color .15s, transform .15s;
  }
  .instances a:hover { border-color: var(--line-strong); transform: translateX(3px); }
  .num {
    position: relative; font-family: var(--display); font-weight: 800; font-size: 22px; width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center; border: 2px solid var(--ink); font-variant-numeric: tabular-nums;
  }
  .num :global(.check) { position: absolute; right: -8px; bottom: -6px; }
  .done .num { border-color: var(--good); }
  .text { display: grid; gap: 2px; min-width: 0; }
  .text strong { font-family: var(--display); font-weight: 800; font-size: 18px; }
  .meta { font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .go { font-family: var(--mono); font-size: 20px; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .instances a { transition: none; } .instances a:hover { transform: none; } }
</style>

<script>
  import { completed } from "../../lib/progress";

  const done = completed();
  document.querySelectorAll<HTMLElement>("[data-progress-id]").forEach((a) =>
    a.classList.toggle("done", done.has(a.dataset.progressId!)));
</script>
