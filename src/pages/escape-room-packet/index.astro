---
// Game 1: printable sheets. Sheets are generated by puzzles/escape-room-packet/
// and rendered into public/escape-room-packet/sheets/ by `npm run puzzles`.
import GameShell from "../../layouts/GameShell.astro";
import { url } from "../../lib/paths";

const sheetsBase = url("escape-room-packet/sheets/");
---
<GameShell title="Escape Room Packet" eyebrow="Mailed escape room · 8 sheets"
  description="Browse every sheet of the escape room, print them, and check your final answer.">
  <p slot="intro">Every sheet from the envelope, in order. Open each sheet&rsquo;s PDF and print it at 100% (Actual Size) so the cut-out and fold lines land where they should. Each sheet hands a number to the next one; the last sheet gives you the final answer to check below.</p>

  <section class="viewer" aria-label="Sheets" id="packet" data-sheets-base={sheetsBase}>
    <ul class="sheets" id="sheet-list"></ul>
    <div class="stage">
      <div class="paper"><img id="sheet-img" alt="" width="1105" height="1430" /></div>
      <div class="controls">
        <button class="btn" id="prev" type="button">&larr; Prev</button>
        <span class="where" id="where"></span>
        <button class="btn" id="next" type="button">Next &rarr;</button>
      </div>
      <a class="btn primary" id="pdf-link" href={`${sheetsBase}letters.pdf`} target="_blank" rel="noopener">Print (PDF)</a>
      <p class="note" id="sheet-note"></p>
    </div>
  </section>

  <section class="slip" aria-labelledby="check-title">
    <h2 id="check-title">Check your final answer</h2>
    <p>Enter the number from the last sheet. Commas and spaces are fine.</p>
    <form id="check-form" autocomplete="off">
      <input id="answer" name="answer" inputmode="numeric" placeholder="00,000" aria-label="Final answer" />
      <button class="btn primary" type="submit">Check answer</button>
    </form>
    <div class="result" id="result" aria-live="polite"></div>
  </section>
</GameShell>

<style is:global>
  .viewer { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 28px; align-items: start; }
  .sheets { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; position: sticky; top: calc(env(safe-area-inset-top, 0px) + 16px); }
  .sheets button {
    width: 100%; display: flex; justify-content: space-between; align-items: baseline; gap: 8px;
    font: 400 15px/1.2 var(--mono); color: var(--ink); background: transparent;
    border: 1px solid transparent; border-radius: 4px; padding: 9px 10px; cursor: pointer; text-align: left;
  }
  .sheets button:hover { border-color: var(--line); }
  .sheets button[aria-current="true"] { background: var(--panel); border-color: var(--line); font-weight: 700; }
  .sheets .kind { font-size: 12px; color: var(--muted); font-weight: 400; }

  .stage { display: grid; gap: 14px; justify-items: center; min-width: 0; }
  .paper {
    width: 100%; max-width: 640px; aspect-ratio: 8.5 / 11; background: var(--paper);
    box-shadow: 0 1px 2px var(--shadow), 0 12px 28px -10px var(--shadow); border-radius: 2px; overflow: hidden;
  }
  .paper img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .controls { width: 100%; max-width: 640px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .where { font-family: var(--mono); font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .note { font-size: 14px; color: var(--muted); max-width: 640px; text-align: center; margin: 0; }

  .slip {
    background: var(--panel); border: 1px dashed var(--line); border-radius: 4px;
    padding: 22px 20px; display: grid; gap: 14px; max-width: 640px; width: 100%; justify-self: center;
  }
  .slip h2 { font-family: var(--display); font-weight: 400; font-size: 26px; margin: 0; }
  .slip p { margin: 0; color: var(--muted); }
  .slip form { display: flex; flex-wrap: wrap; gap: 10px; }
  .slip input {
    flex: 1 1 180px; min-width: 0; font: 400 22px/1 var(--mono); letter-spacing: .08em; font-variant-numeric: tabular-nums;
    color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 4px; padding: 10px 12px;
  }
  .slip .btn { padding-inline: 18px; }
  .result { min-height: 1.5em; font-family: var(--mono); font-size: 15px; }
  .result.bad { color: var(--red); }
  .stamp {
    display: inline-grid; justify-items: center; gap: 2px; padding: 10px 18px; color: var(--good);
    border: 3px double var(--good); border-radius: 50% / 40%; transform: rotate(-4deg);
    font-family: var(--display); font-size: 22px; letter-spacing: .08em;
  }
  .stamp small { font-family: var(--mono); font-size: 12px; letter-spacing: .14em; }
  @media (prefers-reduced-motion: no-preference) { .stamp { animation: thump .35s ease-out; } }
  @keyframes thump { from { transform: rotate(-4deg) scale(1.4); opacity: 0; } to { transform: rotate(-4deg) scale(1); opacity: 1; } }

  @media (max-width: 720px) {
    .viewer { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .sheets { position: static; display: flex; flex-wrap: wrap; gap: 6px; }
    .sheets li { flex: 0 0 auto; }
    .sheets button { padding: 8px 10px; }
    .sheets .kind { display: none; }
  }
</style>

<script>
  import { createHost } from "../../lib/game";

  const SHEETS = [
    { id: "letters", name: "Letters", kind: "grid", file: "letters",
      note: "A page of typed letters. You'll need something else from the envelope to read it." },
    { id: "mask", name: "Cut-out", kind: "holes", file: "letters_mask", note: "Five numbered circles. Scissors help." },
    { id: "page-1", name: "Page 1", kind: "algebra", file: "equations", note: "Starts from the 5 letter word." },
    { id: "page-2", name: "Page 2", kind: "grids", file: "grids", note: "Each label is the sum of its row or column." },
    { id: "page-3", name: "Page 3", kind: "division", file: "remainders", note: "Quotient, then remainder, written side by side." },
    { id: "page-4", name: "Page 4", kind: "fold", file: "fold", note: "Read it flat, then think about the marked lines." },
    { id: "page-5", name: "Page 5", kind: "tree", file: "tree", note: "Every letter means the same number everywhere on this sheet." },
    { id: "page-6", name: "Page 6", kind: "finish", file: "final", note: "The last step." },
  ];
  // SHA-256 of the final answer, so it isn't sitting in the page as plain text.
  const ANSWER_HASH = "c363c2c9dc38e1f30f16b103a6b0d9853ec2fae6dc661492cd2ebc673d3a1475";

  const host = createHost("escape-room-packet");
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const base = $("packet").dataset.sheetsBase!;
  const list = $("sheet-list"), img = $<HTMLImageElement>("sheet-img"), where = $("where"), note = $("sheet-note");
  const prev = $<HTMLButtonElement>("prev"), next = $<HTMLButtonElement>("next"), pdf = $<HTMLAnchorElement>("pdf-link");
  let current = 0;

  SHEETS.forEach((s, i) => {
    const li = document.createElement("li");
    const b = document.createElement("button");
    b.type = "button";
    b.innerHTML = `<span>${s.name}</span><span class="kind">${s.kind}</span>`;
    b.addEventListener("click", () => show(i, true));
    li.appendChild(b);
    list.appendChild(li);
    new Image().src = `${base}${s.file}.png`;   // warm the cache so paging is instant
  });

  function show(i: number, fromUser: boolean) {
    current = Math.max(0, Math.min(SHEETS.length - 1, i));
    const s = SHEETS[current];
    img.src = `${base}${s.file}.png`;
    img.alt = `${s.name}: ${s.note}`;
    pdf.href = `${base}${s.file}.pdf`;
    where.textContent = `${current + 1} / ${SHEETS.length}`;
    note.textContent = s.note;
    prev.disabled = current === 0;
    next.disabled = current === SHEETS.length - 1;
    list.querySelectorAll("button").forEach((b, j) => b.setAttribute("aria-current", String(j === current)));
    if (fromUser) history.replaceState(null, "", "#" + s.id);
  }

  prev.addEventListener("click", () => show(current - 1, true));
  next.addEventListener("click", () => show(current + 1, true));
  document.addEventListener("keydown", (e) => {
    if ((e.target as HTMLElement).closest("input, textarea")) return;
    if (e.key === "ArrowLeft") show(current - 1, true);
    if (e.key === "ArrowRight") show(current + 1, true);
  });
  const startAt = SHEETS.findIndex((s) => "#" + s.id === location.hash);
  show(startAt >= 0 ? startAt : 0, false);

  async function sha256(text: string) {
    const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
  }

  const result = $("result");
  $("check-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const digits = $<HTMLInputElement>("answer").value.replace(/[\s,._']/g, "");
    result.className = "result";
    if (!digits) { result.textContent = "Type the number from the last sheet first."; return; }
    if (!/^\d+$/.test(digits)) { result.className = "result bad"; result.textContent = "Use digits only."; return; }
    if ((await sha256(String(Number(digits)))) === ANSWER_HASH) {
      result.innerHTML = `<span class="stamp">ESCAPED<small>${Number(digits).toLocaleString("en-US")} &middot; DELIVERED</small></span>`;
      host.solved({ answer: Number(digits) });
    } else {
      result.className = "result bad";
      result.textContent = "That's not it. Recheck the number each sheet hands to the next.";
    }
  });
</script>
