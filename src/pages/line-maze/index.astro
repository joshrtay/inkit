---
// Game 2, sheet 1: an interactive number-line puzzle that turns into a maze.
// Logic lives in src/games/line-maze/game.ts; puzzle data in puzzle.json.
import GameShell from "../../layouts/GameShell.astro";
import LineMazeBoard from "../../games/line-maze/LineMazeBoard.astro";
import LineMazeRules from "../../games/line-maze/LineMazeRules.astro";
---
<GameShell title="Number Line Maze" description="Draw the lines each number asks for, then walk the maze you made.">
  <LineMazeBoard id="line-maze" />
  <LineMazeRules slot="directions" />
</GameShell>

<script>
  import { createHost } from "../../lib/game";
  import { mount } from "../../games/line-maze/game";

  mount(document.getElementById("line-maze")!, createHost("line-maze"));
</script>
