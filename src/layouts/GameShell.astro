---
// Shared frame for every game page: back link, title, the game itself, then directions.
// Slots: default = the board and its controls; "intro" = text under the title;
//        "directions" = rule cards shown below the board.
import Base from "./Base.astro";
import { url } from "../lib/paths";
import Check from "../components/Check.astro";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  /** Where the back link goes (default: the home page). */
  back?: { href: string; label: string };
  /** "<type path>/<n>": marks the game finished (check mark) when it fires game:solved. */
  progressId?: string;
  /** The game type's pen color (see GameType.ink). */
  ink?: string;
}
const { title, description, eyebrow, back = { href: url("/"), label: "All games" }, progressId, ink } = Astro.props;
const hasIntro = Astro.slots.has("intro");
const hasDirections = Astro.slots.has("directions");
---
<Base title={title} description={description} ink={ink}>
  <main class="wrap game-page">
    <!-- one slim line, so the board gets the screen -->
    <header class="game-header">
      <a class="back" href={back.href}>&larr; {back.label}</a>
      <div class="title" data-progress-id={progressId}>
        <h1>{title}</h1>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {progressId && <Check size={22} />}
      </div>
    </header>

    <slot />

    {hasIntro && <div class="intro"><slot name="intro" /></div>}
    {hasDirections && <div class="directions"><slot name="directions" /></div>}
  </main>
</Base>

<style>
  /* height of everything that isn't the board: top nav, this header, the paper's control strip, gaps */
  .game-page { --chrome: 176px; max-width: 1400px; gap: 10px; padding-block: 6px 48px; }
  .game-header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; min-height: 30px; }
  .title { display: flex; align-items: center; gap: 10px; min-width: 0; }
  h1 { font-family: var(--display); font-weight: 800; font-size: 20px; line-height: 1.2; margin: 0; }
  .eyebrow { font-size: 12px; }
  .intro { color: var(--muted); max-width: 64ch; margin-top: 14px; }
  .intro :global(p) { margin: 0; }
  .directions { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 16px; margin-top: 14px; }
</style>

<script>
  import { isComplete, markComplete } from "../lib/progress";
  import { account } from "../lib/account";

  const title = document.querySelector<HTMLElement>(".title[data-progress-id]");
  if (title) {
    const id = title.dataset.progressId!;
    if (isComplete(id)) title.classList.add("done");
    document.addEventListener("game:solved", () => {
      const fresh = !isComplete(id);
      markComplete(id);
      title.classList.add("done");
      if (fresh) title.classList.add("animate");
      // First finish while logged out: ask them to log in (after the check mark draws).
      if (!account()) setTimeout(() => document.dispatchEvent(new CustomEvent("account:required")), 900);
    });
  }
</script>
