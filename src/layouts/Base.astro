---
// The page shell every page uses: head, fonts, shared styles and the top nav.
import "../styles/global.css";
import Account from "../components/Account.astro";
import { url } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  /** The pen color for game boards on this page (a game type's ink); defaults to ballpoint blue. */
  ink?: string;
}
const { title, description, ink } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <!-- the saved light/dark choice (src/lib/theme.ts), applied before anything draws -->
    <script is:inline>
      try { const t = localStorage.getItem("wyattsgames:theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}
    </script>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Kalam:wght@400;700&display=swap" />
  </head>
  <body style={ink ? `--paper-ink: ${ink}` : undefined}>
    <!-- The pen wobble every game board is drawn with (global.css: .sheet svg). Hatching and
         watercolor are added per board, at its own scale, by src/lib/ink.ts. -->
    <svg class="ink-defs" aria-hidden="true" focusable="false">
      <filter id="pen" x="-2%" y="-2%" width="104%" height="104%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" />
        <feDisplacementMap in="SourceGraphic" scale="2.2" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <header class="topnav">
      <a class="brand" href={url("/")}>Wyatt&rsquo;s Games</a>
      <Account />
    </header>
    <slot />
  </body>
</html>
