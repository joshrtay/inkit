---
// Lazy River game type: one page per instance (see src/pages/[type]/[n]/index.astro).
// Each level is solved at build time; the build fails unless it has exactly one loop.
import GameShell from "../../layouts/GameShell.astro";
import type { LazyRiverGame } from "../../games";
import { url } from "../../lib/paths";
import type { LazyRiverClientConfig } from "./types";
import { board, solve, toBits, wallBits } from "./solver";
import "./styles.css";

interface Props { game: LazyRiverGame; hostId: string }
const { game, hostId } = Astro.props;
const level = game.river;
const b = board(level);
const sols = solve(b);
if (sols.length !== 1) {
  throw new Error(`src/games/${game.type.path}/${game.number}.json: Lazy River level has ${sols.length === 0 ? "no loop" : "more than one loop"}; add walls or change black cells`);
}
const config: LazyRiverClientConfig = { grid: level.grid, walls: wallBits(level), solution: toBits(b, sols[0]) };
---
<GameShell title={game.name} eyebrow={`${game.type.name} · No. ${game.number}`}
  description={game.type.blurb} back={{ href: url(`${game.type.path}/`), label: game.type.name }}
  progressId={`${game.type.path}/${game.number}`}>
  {game.intro && <p slot="intro">{game.intro}</p>}

  <div class="lazy-river" data-game-type="lazy-river" data-game-id={hostId} data-config={JSON.stringify(config)}>
    <div class="bar">
      <div class="status" aria-live="polite"></div>
      <div class="tools">
        <button class="btn" data-undo type="button">Undo</button>
        <button class="btn" data-check type="button">Check</button>
        <button class="btn" data-reset type="button">Reset</button>
      </div>
    </div>
    <div class="sheet">
      <svg role="img" aria-label="River grid"></svg>
    </div>
  </div>

  <section class="rules current" slot="directions">
    <h2>How to play</h2>
    <ol>
      <li>Draw one continuous loop, the river, that flows through every white cell.</li>
      <li>The river goes straight or turns; it never branches, crosses itself or splits into separate loops.</li>
      <li>It skips the dark cells and can&rsquo;t pass through the thick walls. Two walls side by side make a canyon the river runs straight through.</li>
    </ol>
    <p>Drag between cells to draw the river, and drag over it again to erase. Tap the border between two cells to mark an X where the river can&rsquo;t go. The puzzle checks itself once every cell is filled.</p>
  </section>
</GameShell>

<script>
  import { createHost } from "../../lib/game";
  import { mountAll } from "./game";

  mountAll(createHost);
</script>
