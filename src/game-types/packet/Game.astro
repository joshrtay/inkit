---
// Packet game type: a set of printable sheets (PDFs) and a final answer.
// One page per instance (see src/pages/[type]/[n]/index.astro).
import GameShell from "../../layouts/GameShell.astro";
import { url } from "../../lib/paths";
import { gamePath, type PacketGame } from "../../games";
import type { PacketClientConfig } from "./types";
import { normalizeAnswer } from "./game";
import { sha256 } from "../../lib/hash";
import Icon from "../../components/Icon.astro";
import "./styles.css";

interface Props { game: PacketGame; hostId: string }
const { game, hostId } = Astro.props;
const { sheets, answer } = game.packet;

// Only a hash of the answer reaches the browser.
const config: PacketClientConfig = {
  sheets,
  sheetsBase: url(`${gamePath(game)}sheets/`),
  answerHash: await sha256(normalizeAnswer(answer)),
};
---
<GameShell ink={game.type.ink} title={game.name} eyebrow={`No. ${game.number}`}
  description={game.type.blurb} back={{ href: url(`${game.type.path}/`), label: game.type.name }}
  progressId={`${game.type.path}/${game.number}`}>
  <div class="packet" data-game-type="packet" data-game-id={hostId} data-config={JSON.stringify(config)}>
    <div class="sheet" style="--ratio: 0.7727">
      <div class="paper-bar">
        <div class="group">
          <button class="tool" data-prev type="button" aria-label="Previous sheet" title="Previous sheet"><Icon name="prev" /></button>
          <span class="where" data-where></span>
          <button class="tool" data-next type="button" aria-label="Next sheet" title="Next sheet"><Icon name="next" /></button>
        </div>
        <div class="group">
          <a class="tool" data-pdf href={`${config.sheetsBase}${sheets[0].file}.pdf`} target="_blank" rel="noopener"
             aria-label="Print this sheet (PDF, print at 100%)" title="Print this sheet (PDF, print at 100%)"><Icon name="print" /></a>
        </div>
      </div>
      <img data-sheet-img alt="" width="1105" height="1430" />
    </div>

    <aside class="side">
      <label class="pick">
        <span>Sheet</span>
        <select data-sheet-select>
          {sheets.map((s, i) => <option value={i}>{s.name} &middot; {s.kind}</option>)}
        </select>
      </label>
      <p class="note" data-note></p>

      <section class="slip" aria-labelledby="packet-check">
        <h2 id="packet-check">Check your final answer</h2>
        <p>Enter the number from the last sheet. Commas and spaces are fine.</p>
        <form data-check autocomplete="off">
          <input data-answer name="answer" inputmode="numeric" placeholder="00,000" aria-label="Final answer" />
          <button class="btn primary" type="submit">Check answer</button>
        </form>
        <div class="result" data-result aria-live="polite"></div>
      </section>
    </aside>
  </div>
</GameShell>

<script>
  import { createHost } from "../../lib/game";
  import { mountAll } from "./game";

  mountAll(createHost);
</script>
