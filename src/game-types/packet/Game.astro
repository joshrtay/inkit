---
// Packet game type: a set of printable sheets (PDFs) and a final answer.
// One page per instance (see src/pages/[slug]/index.astro).
import GameShell from "../../layouts/GameShell.astro";
import { url } from "../../lib/paths";
import type { PacketGame } from "../../games";
import type { PacketClientConfig } from "./types";
import { normalizeAnswer, sha256 } from "./game";
import "./styles.css";

interface Props { game: PacketGame }
const { game } = Astro.props;
const { sheets, answer } = game.packet;

// Only a hash of the answer reaches the browser.
const config: PacketClientConfig = {
  sheets,
  sheetsBase: url(`${game.slug}/sheets/`),
  answerHash: await sha256(normalizeAnswer(answer)),
};
---
<GameShell title={game.name} eyebrow={game.eyebrow} description={game.blurb}>
  {game.intro && <p slot="intro">{game.intro}</p>}

  <div class="packet" data-game-type="packet" data-game-id={game.slug} data-config={JSON.stringify(config)}>
    <section class="viewer" aria-label="Sheets">
      <ul class="sheets" data-sheet-list></ul>
      <div class="stage">
        <div class="paper"><img data-sheet-img alt="" width="1105" height="1430" /></div>
        <div class="controls">
          <button class="btn" data-prev type="button">&larr; Prev</button>
          <span class="where" data-where></span>
          <button class="btn" data-next type="button">Next &rarr;</button>
        </div>
        <a class="btn primary" data-pdf href={`${config.sheetsBase}${sheets[0].file}.pdf`} target="_blank" rel="noopener">Print (PDF)</a>
        <p class="note" data-note></p>
      </div>
    </section>

    <section class="slip" aria-labelledby={`${game.slug}-check`}>
      <h2 id={`${game.slug}-check`}>Check your final answer</h2>
      <p>Enter the number from the last sheet. Commas and spaces are fine.</p>
      <form data-check autocomplete="off">
        <input data-answer name="answer" inputmode="numeric" placeholder="00,000" aria-label="Final answer" />
        <button class="btn primary" type="submit">Check answer</button>
      </form>
      <div class="result" data-result aria-live="polite"></div>
    </section>
  </div>
</GameShell>

<script>
  import { createHost } from "../../lib/game";
  import { mountAll } from "./game";

  mountAll(createHost);
</script>
