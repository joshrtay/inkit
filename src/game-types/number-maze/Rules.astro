---
// The two direction cards shown under the board. The current phase's card is outlined.
import type { Side } from "./types";

interface Props { entry: Side; exit: Side }
const { entry, exit } = Astro.props;
---
<div class="number-maze-rules">
  <section class="rules current" data-rules="draw">
    <h2>Phase 1 &middot; Build the walls</h2>
    <ol>
      <li>Draw walls between neighboring numbers: up, down, left or right.</li>
      <li>Each number tells you how many walls touch it, including walls along the outside edge.</li>
      <li>Walls never close into a loop, and every wall connects to the border.</li>
    </ol>
    <p>Draw the outside edge too: it&rsquo;s all wall except at the two arrows. Drag across numbers to draw a wall; drag over it again, or tap it, to erase. Blue walls are given. A number turns green when it has the right count and red when it has too many.</p>
  </section>
  <section class="rules" data-rules="walk">
    <h2>Phase 2 &middot; Walk the maze</h2>
    <ol>
      <li>Enter at the arrow on the {entry} edge.</li>
      <li>Move through the open squares. You can&rsquo;t cross a wall.</li>
      <li>Leave by the arrow on the {exit} edge.</li>
    </ol>
    <p>Unlocks when the walls are finished. Drag the red marker through the maze; drag back over your line to undo it. Tapping squares and the arrow keys work too.</p>
  </section>
</div>

<style>
  .number-maze-rules { display: contents; }
</style>

<script>
  document.addEventListener("number-maze:phase", (e) => {
    const phase = (e as CustomEvent<string>).detail;
    document.querySelectorAll<HTMLElement>("[data-rules]").forEach((card) =>
      card.classList.toggle("current", card.dataset.rules === phase));
  });
</script>
