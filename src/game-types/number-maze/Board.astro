---
// Board markup for a number maze: the paper, with its controls in a strip across the top.
// game.ts fills in the SVG from data-config.
import "./styles.css";
import Icon from "../../components/Icon.astro";
import type { NumberMazeConfig } from "./types";

interface Props { gameId: string; config: NumberMazeConfig }
const { gameId, config } = Astro.props;
---
<div class="number-maze" data-game-type="number-maze" data-game-id={gameId} data-config={JSON.stringify(config)}>
  <div class="sheet">
    <div class="paper-bar">
      <div class="group phases" role="group" aria-label="Phase">
        <button class="word phase" data-phase="draw" type="button" aria-pressed="true">1 build</button>
        <button class="word phase" data-phase="walk" type="button" aria-pressed="false" disabled>2 walk</button>
      </div>
      <div class="status" aria-live="polite"></div>
      <div class="group">
        <button class="word go" data-go-walk type="button" hidden>walk it &rarr;</button>
        <button class="tool" data-undo type="button" aria-label="Undo" title="Undo"><Icon name="undo" /></button>
        <button class="tool" data-clear type="button" aria-label="Reset" title="Reset"><Icon name="reset" /></button>
      </div>
    </div>
    <svg class="board" role="img" aria-label="Number grid"></svg>
  </div>
</div>
