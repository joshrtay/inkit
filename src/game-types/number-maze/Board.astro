---
// Toolbar + board markup for a number maze. game.ts fills in the SVG from data-config.
import "./styles.css";
import type { NumberMazeConfig } from "./types";

interface Props { gameId: string; config: NumberMazeConfig }
const { gameId, config } = Astro.props;
---
<div class="number-maze" data-game-type="number-maze" data-game-id={gameId} data-config={JSON.stringify(config)}>
  <div class="bar">
    <div class="phases" role="group" aria-label="Phase">
      <button class="phase" data-phase="draw" type="button" aria-pressed="true">1 &middot; Build the walls</button>
      <button class="phase" data-phase="walk" type="button" aria-pressed="false" disabled>2 &middot; Walk the maze</button>
    </div>
    <div class="progress">
      <div class="status" aria-live="polite"></div>
      <div class="meter" aria-hidden="true"><span></span></div>
    </div>
    <div class="tools">
      <button class="btn" data-undo type="button">Undo</button>
      <button class="btn" data-clear type="button">Reset</button>
      <button class="btn primary" data-go-walk type="button" hidden>Walk the maze &rarr;</button>
    </div>
  </div>
  <div class="sheet">
    <svg role="img" aria-label="Number grid"></svg>
  </div>
</div>
