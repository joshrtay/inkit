/**
 * The social site, served at https://inkit.games: React Router on Cloudflare Workers, with D1
 * (database) and R2 (sketch photos). `npm run dev` runs it all locally (.dev.vars points
 * BETTER_AUTH_URL at localhost); `npm run deploy` publishes it.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wyattsgames",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wyattsgames-db",
			"database_id": "0e9cb4d5-3d33-4fa7-8bbd-f5d8a157508d",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "wyattsgames-media" }],
	/** Cloudflare creates the DNS record for the domain on deploy. */
	"routes": [{ "pattern": "inkit.games", "zone_name": "inkit.games", "custom_domain": true }],
	"vars": {
		/** Where the site is served; Better Auth builds links and checks request origins with it. */
		"BETTER_AUTH_URL": "https://inkit.games"
	}
	/**
	 * Secrets (never committed): BETTER_AUTH_SECRET, ANTHROPIC_API_KEY, and optionally
	 * GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET. Locally they come from .dev.vars; in production
	 * set them with `npx wrangler secret put <NAME>`.
	 */
}
