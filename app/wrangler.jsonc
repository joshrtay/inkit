/**
 * The social site, served at https://inkit.games: React Router on Cloudflare Workers, with D1
 * (database) and R2 (sketch photos). `npm run dev` runs it all locally (.dev.vars points
 * BETTER_AUTH_URL at localhost); `npm run deploy` publishes it.
 */
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "inkit",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "inkit-db",
			"database_id": "9bf3bfcb-0e34-40b2-8eb1-67b0c18358db",
			"migrations_dir": "drizzle"
		}
	],
	/** Every minute (one indexed query): publish the AI creators' scheduled drafts that are due (workers/app.ts). */
	"triggers": { "crons": ["* * * * *"] },
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "inkit-media" }],
	/** Cloudflare Images: uploads are turned upright and stripped of their metadata, and only the
	 *  puzzle is kept (cropped to what Claude says is the puzzle; app/lib/photos.server.ts). */
	"images": { "binding": "IMAGES" },
	/** Cloudflare Email Service: password reset emails from no-reply@inkit.games (simulated locally). */
	"send_email": [{ "name": "EMAIL" }],
	/** Cloudflare creates the DNS records for these domains on deploy. wyattsgames.com (Wyatt's old
	 *  site) only redirects to his profile here (workers/app.ts). */
	"routes": [
		{ "pattern": "inkit.games", "zone_name": "inkit.games", "custom_domain": true },
		{ "pattern": "wyattsgames.com", "zone_name": "wyattsgames.com", "custom_domain": true },
		{ "pattern": "www.wyattsgames.com", "zone_name": "wyattsgames.com", "custom_domain": true }
	],
	"vars": {
		/** Where the site is served; Better Auth builds links and checks request origins with it. */
		"BETTER_AUTH_URL": "https://inkit.games"
	}
	/**
	 * Secrets (never committed): BETTER_AUTH_SECRET, ANTHROPIC_API_KEY, and optionally
	 * GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET; for bug reports (docs/bug-pipeline.md),
	 * GITHUB_ISSUES_TOKEN and BUG_BUNDLE_TOKEN. Locally they come from .dev.vars; in production
	 * set them with `npx wrangler secret put <NAME>`.
	 */
}
