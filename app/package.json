{
  "name": "inkit-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply inkit-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply inkit-db --remote",
    "db:seed": "wrangler d1 execute inkit-db --local --file seed/dev.sql",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:reader": "READER_EVAL=1 playwright test reader.spec.ts",
    "eval": "vite-node --config vitest.config.ts eval/run.ts --",
    "eval:pull": "vite-node --config vitest.config.ts eval/pull.ts --"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@rrweb/record": "2.1.7",
    "better-auth": "^1.7.7",
    "clingo-wasm": "^0.6.0",
    "drizzle-orm": "^0.45.3",
    "html-to-image": "1.11.13",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "rrweb-player": "2.1.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.147.0"
  }
}
